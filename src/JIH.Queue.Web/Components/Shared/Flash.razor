@* Short-lived message. Set Message + IsError from the parent and call StateHasChanged. *@
@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert @(IsError ? "alert-error" : "alert-ok") @(Toast ? "toast" : "")" role="@(IsError ? "alert" : "status")">@Message</div>
}
@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public bool IsError { get; set; }
    [Parameter] public bool Toast { get; set; }
}
