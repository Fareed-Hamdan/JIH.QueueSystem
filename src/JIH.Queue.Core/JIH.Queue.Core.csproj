<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Core domain + business rules. Deliberately has NO NuGet dependencies so it builds offline.
    The ASP.NET Core shared framework gives us logging, options and the Identity password hasher.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JIH.Queue.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
