<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Oracle storage for the queue system (EF Core 10 + Oracle's official provider).
    Supports Oracle Database 19c or later (tested target: Oracle Database 23ai Free in Docker).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>JIH.Queue.Data.Oracle</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26400" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JIH.Queue.Core\JIH.Queue.Core.csproj" />
  </ItemGroup>
</Project>
