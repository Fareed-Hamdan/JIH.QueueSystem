# Copy to .env and change every value before installing.
ORACLE_SYS_PASSWORD=ChangeMe_Sys_2026
APP_DB_PASSWORD=ChangeMe_App_2026
# Address that patients' phones can reach (server LAN IP or DNS name + port 8080)
PUBLIC_BASE_URL=http://192.168.1.20:8080
# Long random string (signs the rotating reception QR code)
QR_SECRET=replace-with-a-long-random-string
# true = create sample waiting patients on first start (dummy data)
SEED_DEMO_TICKETS=false
# Twilio sandbox / trial (leave empty to keep the "Mock" channel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
TWILIO_SMS_FROM=
